// Sommerhus Bookmaker — schema
//
// Postgres-backed for deployment (see README for Neon/Vercel setup). The
// project started on SQLite for local prototyping; status/type fields below
// are still plain strings rather than native enums (see lib/constants.ts) —
// that was originally so the schema worked unchanged on SQLite, and it's
// harmless now, so it stayed that way rather than being churned for no
// functional benefit.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL is Neon's pooled connection (used at runtime, incl. via the
  // driver adapter in lib/prisma.ts). Migrations go through the unpooled
  // connection instead — pgbouncer-style poolers don't play well with the
  // prepared statements Prisma Migrate issues.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// MarketStatus:    OPEN | CLOSED | SETTLED | VOID
// BetStatus:       PENDING | WON | LOST | REFUNDED
// BalanceTxnType:  BET_PLACED | BET_PAYOUT | BET_REFUND | ADMIN_ADJUSTMENT
//
// BalanceTransaction logs every change to a player's balance — this is what
// powers the /me sparkline and the admin adjustment audit trail. It's a side
// effect of the mutations in lib/betting.ts, never written to directly.

model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  balance   Int      @default(1000)
  createdAt DateTime @default(now())

  bets         Bet[]
  balanceTxns  BalanceTransaction[]
  marketBlocks MarketBlock[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  markets MarketCategory[]
}

// Join row: a market tagged with a category. A market can have several
// (e.g. both "Specials" and "Øl-maraton"), unlike day, which is single.
model MarketCategory {
  id         String   @id @default(cuid())
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([marketId, categoryId])
}

model Market {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("OPEN")
  closesAt    DateTime?
  createdAt   DateTime  @default(now())
  settledAt   DateTime?

  // One of lib/constants.ts's MARKET_DAYS ("Dag 1".."Dag 5", "Hele turen").
  // Fixed trip schedule, not admin-creatable like Category.
  day String @default("Hele turen")

  categories MarketCategory[]

  outcomes Outcome[]
  blocks   MarketBlock[]

  @@index([status])
  @@index([day])
}

// A player blocked from betting on a specific market — e.g. blocking Thom
// from "Does Thom jump in the lake?" so he can't bet on his own outcome.
model MarketBlock {
  id        String   @id @default(cuid())
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([marketId, playerId])
}

model Outcome {
  id       String  @id @default(cuid())
  marketId String
  market   Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  label    String
  // Decimal odds, e.g. 2.50 means stake * 2.50 returned on a win.
  odds     Float
  isWinner Boolean @default(false)

  bets Bet[]

  @@index([marketId])
}

model Bet {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  outcomeId String
  outcome   Outcome @relation(fields: [outcomeId], references: [id])

  stake           Int
  // Locked in at placement time so later odds edits never affect this bet.
  oddsAtPlacement Float
  status          String   @default("PENDING")
  // Null until the bet is resolved (won/lost/refunded).
  payout          Int?
  createdAt       DateTime @default(now())

  balanceTxns BalanceTransaction[]

  @@index([playerId])
  @@index([outcomeId])
}

model BalanceTransaction {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  type         String
  // Signed delta applied to the balance (negative for stakes/fines).
  amount       Int
  balanceAfter Int
  reason       String?
  betId        String?
  bet          Bet?     @relation(fields: [betId], references: [id])
  createdAt    DateTime @default(now())

  @@index([playerId, createdAt])
}
