# Local dev default matches docker-compose.yml (run `docker compose up -d` first).
# In production, point this at your hosted Postgres connection string instead
# (Neon, Vercel Postgres, Supabase, etc.) — see README for deploy steps.
DATABASE_URL="postgresql://sommerhus:sommerhus@localhost:5432/sommerhus"
ADMIN_PIN="1234"

# One 3-digit code per player: <NAME>_PIN, name uppercased with æøå
# transliterated to ae/o/a (env var names can't hold non-ASCII characters —
# Next.js's env loader silently drops ones that do). Entered after picking
# your name on /select-player. Add one of these for every player in the DB.
KARL_PIN="111"
KLOSE_PIN="222"
KLA_PIN="333"
THOM_PIN="444"
LYNG_PIN="555"
ZAK_PIN="666"
STUB_PIN="777"
BJORN_PIN="888"
